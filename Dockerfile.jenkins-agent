FROM maven:3.9.9-eclipse-temurin-17

# Jenkins CI agent image: JDK 17 + Maven + Google Chrome (headless-capable)
# for running Selenium/Cucumber/TestNG tests. Chromedriver itself is
# downloaded at test-runtime by WebDriverManager to match the installed
# Chrome version, so it does not need to be baked into this image.

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget gnupg ca-certificates fonts-liberation unzip \
    && wget -q -O /tmp/google-chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get install -y /tmp/google-chrome.deb \
    && rm -f /tmp/google-chrome.deb \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/google-chrome

# Allure commandline, baked into the image so the Jenkins Allure plugin's
# "post" step (which runs via docker exec inside this container) can find
# it — auto-install into the controller's jenkins_home/tools is not visible
# from inside this container.
ARG ALLURE_VERSION=2.29.0
RUN wget -q -O /tmp/allure.zip "https://repo1.maven.org/maven2/io/qameta/allure/allure-commandline/${ALLURE_VERSION}/allure-commandline-${ALLURE_VERSION}.zip" \
    && unzip -q /tmp/allure.zip -d /opt \
    && mv /opt/allure-${ALLURE_VERSION} /opt/allure \
    && rm -f /tmp/allure.zip
ENV PATH="/opt/allure/bin:${PATH}"
